{
    "compilerOptions": {
      "module": "CommonJS",
      "target": "ES2020",
      "outDir": "dist",
      "esModuleInterop": true,
      "strict": true,
      "moduleResolution": "node",
      "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": [
      "src/angular/**/*",
      "src/renderer/**/*",
      "src/app/**/*",
      "src/angular-main.ts"
    ]
  }